APP_NAME="RS3 GP Treasury"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://treasury.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rs3_gp_treasury
DB_USER=rs3_gp_treasury
DB_PASS=change_me

# Fallback admin web login. Keep this set even when Discord OAuth is enabled.
ADMIN_UI_PASSWORD=change_this_to_a_long_random_secret

# Discord OAuth admin login.
# Create a Discord application, add the redirect URL below in OAuth2 settings,
# then set DISCORD_OAUTH_ENABLED=true.
DISCORD_OAUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://treasury.example.com/?page=discord_callback

# Optional security controls.
# OWNER user IDs can always sign in.
# Linked treasury admins can sign in when their treasury_admins.discord_user_id matches.
# Role checks require DISCORD_GUILD_ID and DISCORD_ADMIN_ROLE_IDS.
DISCORD_OWNER_USER_IDS=
DISCORD_ALLOW_LINKED_TREASURY_ADMINS=true
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_REQUIRE_GUILD_MEMBER=false
DISCORD_LOCK_ACTING_ADMIN_TO_LOGIN=false

# Required for admin-only API actions once API integrations are added.
# Generate a long random value and keep it private.
ADMIN_API_TOKEN=change_this_to_a_long_random_secret

# Optional: comma-separated origins for browser API access.
CORS_ALLOWED_ORIGINS=
