APP_NAME="RS3 GP Treasury"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://treasury.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rs3_gp_treasury
DB_USER=rs3_gp_treasury
DB_PASS=change_me

# Required for the temporary admin web login until Discord OAuth is added.
ADMIN_UI_PASSWORD=change_this_to_a_long_random_secret

# Required for admin-only API actions until Discord OAuth/admin UI is added.
# Generate a long random value and keep it private.
ADMIN_API_TOKEN=change_this_to_a_long_random_secret

# Optional: comma-separated origins for browser API access.
CORS_ALLOWED_ORIGINS=
