APP_NAME="RS3 GP Treasury"
APP_TAGLINE="RS3 GP Ledger"
# Optional logo shown in the sidebar/login brand block. Use a public path such as assets/logo.png or a full https URL.
APP_LOGO_URL=
# Favicon URL. The packaged default is public/favicon.ico.
APP_FAVICON_URL=favicon.ico
APP_ENV=local
APP_DEBUG=true
APP_URL=https://treasury.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rs3_gp_treasury
DB_USER=rs3_gp_treasury
DB_PASS=change_me

# Fallback admin web login. Set ADMIN_PASSWORD_LOGIN_ENABLED=false to force Discord-only login.
ADMIN_PASSWORD_LOGIN_ENABLED=true
ADMIN_UI_PASSWORD=change_this_to_a_long_random_secret

# Discord OAuth admin login.
# Create a Discord application, add the redirect URL below in OAuth2 settings,
# then set DISCORD_OAUTH_ENABLED=true.
DISCORD_OAUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://treasury.example.com/?page=discord_callback

# Optional security controls.
# OWNER user IDs can always sign in.
# Linked treasury admins can sign in when their treasury_admins.discord_user_id matches.
# Role checks require DISCORD_GUILD_ID and DISCORD_ADMIN_ROLE_IDS.
DISCORD_OWNER_USER_IDS=
DISCORD_ALLOW_LINKED_TREASURY_ADMINS=true
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_REQUIRE_GUILD_MEMBER=false
DISCORD_LOCK_ACTING_ADMIN_TO_LOGIN=false

# Required for admin-only API actions once API integrations are added.
# Generate a long random value and keep it private.
ADMIN_API_TOKEN=change_this_to_a_long_random_secret

# Optional: comma-separated origins for browser API access.
CORS_ALLOWED_ORIGINS=

# Database bootstrap.
# Enabled by default so the app can keep required tables/columns/system records in sync on load.
DB_BOOTSTRAP_ENABLED=true

# Optional. Only enable if the DB user is allowed to CREATE DATABASE and you want the app to create DB_NAME automatically.
DB_BOOTSTRAP_CREATE_DATABASE=false

# Optional. Normally false; the bootstrapper records a schema version and only re-runs when the app schema version changes.
DB_BOOTSTRAP_RUN_EVERY_REQUEST=false

# API request logging.
# Stores API request/response metadata so integrations can be debugged from the admin UI.
API_REQUEST_LOG_ENABLED=true
API_REQUEST_LOG_BODY_MAX_BYTES=20000
